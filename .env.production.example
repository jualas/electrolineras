# Plantilla producción — SIN secretos reales (#6043)
#
# Copiar y editar (no commitear el destino):
#   cp .env.production.example .env
#
# Docker (recomendado en mini PC):
#   cp docker/env.example /mnt/datos/docker/electrolineras/.env
#
# Documentación: docs/ENV.md
# Validar: make env-check-prod ENV_FILE=.env

# ── Obligatorias ─────────────────────────────────────────────────────────────

# SQLite — ruta ABSOLUTA en contenedor Docker o host
DATABASE_URL=sqlite:////app/data/db/stations.db

# Origen del frontend (sin *). Mismo dominio que Cloudflare Tunnel.
API_CORS_ORIGINS=https://electro.jualas.es

# OSRM — en prod usar instancia local (ver docker/osrm/)
OSRM_BASE_URL=http://electrolineras-osrm-car:5000
OSRM_SHORTEST_BASE_URL=http://electrolineras-osrm-shortest:5000
OSRM_USE_MULTI_PROFILE=true
OSRM_PROFILE_FASTEST=car
OSRM_PROFILE_SHORTEST=shortest
OSRM_PROFILE_CONVENTIONAL=car
OSRM_TIMEOUT_SECONDS=60

# Nominatim self-hosted (#6046 — docker/nominatim/)
NOMINATIM_USER_AGENT=Electrolineras/0.1.0 (https://electro.jualas.es; contact: admin@example.com)
NOMINATIM_BASE_URL=http://host.docker.internal:8092
NOMINATIM_FALLBACK_BASE_URL=
NOMINATIM_CACHE_ENABLED=true
NOMINATIM_CACHE_TTL_SECONDS=86400
NOMINATIM_COUNTRY_CODES=es,pt
NOMINATIM_TIMEOUT_SECONDS=15
NEARBY_RADIUS_M_DEFAULT=1000
NEARBY_RADIUS_M_MAX=10000

# ── API (prod) ───────────────────────────────────────────────────────────────

API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
API_ENVIRONMENT=production

# Hardening (#6042)
API_RATE_LIMIT_ENABLED=true
API_TRUST_PROXY_HEADERS=true
API_MAX_REQUEST_BODY_BYTES=65536
API_DOCS_ENABLED=false

# SPA servida por FastAPI (mismo origen)
SERVE_WEB_STATIC=true
WEB_DIST_PATH=src/web/dist

# Build frontend: VITE_API_URL vacío → same-origin (/api/v1/...)
# cd src/web && VITE_API_URL= npm run build

# ── Routing / búsqueda ───────────────────────────────────────────────────────

OSRM_FASTEST_REQUEST_ALTERNATIVES=true
OSRM_FASTEST_ALTERNATIVES_COUNT=3
OSRM_FASTEST_ALTERNATIVE_TOLERANCE=0.08
# Acerca ETA a Google/autovía real (duration_osrm / factor). 1.0 = sin ajuste.
OSRM_SPEED_FACTOR=1.15
ROUTE_CORRIDOR_KM_DEFAULT=10
ROUTE_BEHIND_MARGIN_KM_DEFAULT=2
ROUTE_WRONG_SIDE_PENALTY_KM_DEFAULT=5
ROUTE_RESULTS_LIMIT_DEFAULT=15

# ── Ingestión (cron en host — scripts/cron/electrolineras.env) ───────────────

NAP_ES_URL=https://infocar.dgt.es/datex2/v3/miterd/EnergyInfrastructureTablePublication/electrolineras.xml
NAP_PT_URL=https://pgm.mobie.pt/integration/nap/evChargingInfra
FETCH_MAX_RETRIES=3
FETCH_RETRY_BACKOFF_SECONDS=2
FETCH_TIMEOUT_SECONDS=120
FETCH_PT_TIMEOUT_SECONDS=900

# ── Secretos — rellenar en .env real (NO commitear) ──────────────────────────

# Cloudflare Tunnel (Zero Trust → Tunnels → token)
CLOUDFLARED_TOKEN=

# Login TOTP multiusuario (pestaña Asistente) — generar:
#   python scripts/auth/setup_private_auth.py --username <nombre> --apply .env
PRIVATE_STACK_ENABLED=false
CHARGING_AGENT_ENABLED=true
SESSION_SECRET=
SESSION_COOKIE_SECURE=true
AUTH_SESSION_MAX_AGE_SECONDS=604800
# "usuario1:SECRETO1,usuario2:SECRETO2" — un usuario por miembro de la familia
PRIVATE_AUTH_USERS=
PRIVATE_API_TOKEN=
AGENT_API_TOKEN=

# Dify (solo LAN). Ver docs/DIFY_TRIP_GUIDE.md
DIFY_API_BASE_URL=http://<IP-LAN-SERVIDOR>:8590/v1
DIFY_TRIP_WORKFLOW_API_KEY=
DIFY_TIMEOUT_SECONDS=90

# TeslaMate MQTT — ver docs/PHASE3_PRIVATE_STACK.md
TESLAMATE_DATA_SOURCE=auto
TESLAMATE_CAR_ID=1
TESLAMATE_CAR_DISPLAY_NAME=The Ship
TESLAMATE_MQTT_HOST=<IP-LAN-SERVIDOR>
TESLAMATE_MQTT_PORT=1883
TESLAMATE_MQTT_USERNAME=
TESLAMATE_MQTT_PASSWORD=
TESLAMATE_MQTT_TOPIC_PREFIX=teslamate/cars
TESLAMATE_API_BASE_URL=
TESLAMATE_API_TOKEN=

# Open Charge Map (opcional, cron)
OCM_API_KEY=

# REVE — API oficial con clave (cron; docs en mapareve.es/docs/api/external/v1)
REVE_API_KEY=
