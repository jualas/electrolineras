# syntax=docker/dockerfile:1
# SPA Vite + nginx reverse proxy hacia electrolineras-api.

FROM node:22-alpine AS web-build
WORKDIR /build
COPY src/web/package.json src/web/package-lock.json ./
RUN npm ci
COPY src/web .
ENV VITE_API_URL=
RUN npm run build

FROM nginx:1.27-alpine

COPY docker/nginx/electrolineras.conf /etc/nginx/conf.d/default.conf
COPY --from=web-build /build/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/health | grep -q ok || exit 1
