# Copiar a .env en /mnt/datos/docker/electrolineras/
# cp env.example .env

ELECTROLINERAS_SRC=/mnt/datos/Proyectos/Electrolineras
ELECTROLINERAS_DATA=/mnt/datos/docker/volumes/electrolineras-data
ELECTROLINERAS_PORT=0.0.0.0:8015:8000

# Ruta absoluta SQLite dentro del contenedor (compose también la fija)
DATABASE_URL=sqlite:////app/data/db/stations.db

API_CORS_ORIGINS=https://electro.jualas.es,http://127.0.0.1:8015,http://<IP-LAN-SERVIDOR>:8015

OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=30
ROUTE_CORRIDOR_KM_DEFAULT=10
ROUTE_BEHIND_MARGIN_KM_DEFAULT=2
ROUTE_WRONG_SIDE_PENALTY_KM_DEFAULT=5
ROUTE_RESULTS_LIMIT_DEFAULT=15

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Electrolineras/0.1.0 (https://electro.jualas.es; contact: admin@jualas.es)
NOMINATIM_COUNTRY_CODES=es,pt
NOMINATIM_TIMEOUT_SECONDS=15
NEARBY_RADIUS_M_DEFAULT=1000
NEARBY_RADIUS_M_MAX=10000

NAP_ES_URL=https://infocar.dgt.es/datex2/v3/miterd/EnergyInfrastructureTablePublication/electrolineras.xml
NAP_PT_URL=https://pgm.mobie.pt/integration/nap/evChargingInfra
FETCH_MAX_RETRIES=3
FETCH_RETRY_BACKOFF_SECONDS=2
FETCH_TIMEOUT_SECONDS=120
FETCH_PT_TIMEOUT_SECONDS=900

# Cloudflare Tunnel (servicio electrolineras-cloudflared en docker-compose.yml)
# Token: Zero Trust → Networks → Tunnels → Install connector
CLOUDFLARED_TOKEN=
