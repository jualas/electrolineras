[Unit]
Description=Electrolineras OSRM (car + shortest Iberia)
Documentation=file:///mnt/datos/Proyectos/Electrolineras/docker/osrm/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=jualas
Group=jualas
WorkingDirectory=/mnt/datos/Proyectos/Electrolineras/docker/osrm
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Asegura compose + política restart: unless-stopped tras reboot del host
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
