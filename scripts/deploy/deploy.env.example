# Entorno para scripts/deploy/*.sh (#6044)
#
#   cp scripts/deploy/deploy.env.example scripts/deploy/deploy.env

ELECTROLINERAS_REPO=/mnt/datos/Proyectos/Electrolineras
DEPLOY_COMPOSE_DIR=/mnt/datos/docker/electrolineras
DEPLOY_HEALTH_URL=http://127.0.0.1:8015/health
DEPLOY_SERVICE=electrolineras
DEPLOY_IMAGE_NAME=electrolineras:local
DEPLOY_ROLLBACK_TAG=electrolineras:previous

# Opcional: ref concreto (tag o rama)
# DEPLOY_REF=v0.1.0

# Cloudflare — hostname staging (#6142); ver scripts/deploy/cloudflare-staging-hostname.sh
# CLOUDFLARE_API_TOKEN=
