# Copiar a cursor-bridge.env (chmod 600, fuera de git) y ajustar. Arranque: ./scripts/dify/run_cursor_bridge.sh
# Detalle de cada variable: /mnt/datos/docker/dify/integrations/dify-cursor/cursor-cli-bridge/README.md
DIFY_CURSOR_REPO=/mnt/datos/docker/dify

# 0.0.0.0 para que lleguen los contenedores; el filtro de redes de origen deja fuera LAN, Wi-Fi y VPN
CURSOR_BRIDGE_HOST=0.0.0.0
CURSOR_BRIDGE_PORT=18765
# Obligatorio, mínimo 32 caracteres (p. ej. `openssl rand -hex 32`); el mismo en el .env de cada cliente
CURSOR_BRIDGE_TOKEN=
# Redes de origen admitidas: local + redes Docker de los clientes (Dify docker_default, electrolineras_default)
# Ver la subred con: docker network inspect <red> -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
CURSOR_BRIDGE_ALLOWED_NETS=127.0.0.0/8,<SUBRED-DOCKER-DIFY>,<SUBRED-DOCKER-ELECTROLINERAS>

CURSOR_BRIDGE_TIMEOUT_SEC=600
CURSOR_CLI_PATH=/home/<usuario>/.local/bin/cursor
# Modo «preguntar»: el agente no ejecuta comandos
CURSOR_CLI_EXTRA_ARGS="agent -p --mode ask"

# Agente en contenedor desechable con HOME propio (sin ficheros ni MCP del usuario)
CURSOR_BRIDGE_ISOLATION=docker
CURSOR_BRIDGE_AGENT_HOME=/home/<usuario>/.local/share/agentes-ia/home

# Prompt experto EV (#6155) — versión en el repo Electrolineras
ELECTROLINERAS_EV_EXPERT_PROMPT=/mnt/datos/Proyectos/Electrolineras/docs/agent/ev_expert_prompt.md

# URL desde los contenedores: Electrolineras usa http://host.docker.internal:18765/invoke;
# Dify, el gateway de su red docker_default (http://<GATEWAY-DOCKER-DIFY>:18765/invoke).
