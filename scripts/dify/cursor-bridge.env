# Copiar a cursor-bridge.env y ajustar. Arranque: ./scripts/dify/run_cursor_bridge.sh
DIFY_CURSOR_REPO=/mnt/datos/docker/dify

CURSOR_BRIDGE_HOST=0.0.0.0
CURSOR_BRIDGE_PORT=18765
# CURSOR_BRIDGE_TOKEN=

CURSOR_BRIDGE_TIMEOUT_SEC=600
CURSOR_CLI_PATH=/home/jualas/.local/bin/cursor
CURSOR_CLI_EXTRA_ARGS="agent -p"

# URL para el nodo HTTP del workflow Dify (desde contenedores hacia el host)
# http://<IP-LAN-SERVIDOR>:18765/invoke  |  http://host.docker.internal:18765/invoke
