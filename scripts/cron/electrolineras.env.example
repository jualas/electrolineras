# Entorno para cron en el mini PC (producción).
# Copiar a scripts/cron/electrolineras.env y ajustar.
#
#   cp scripts/cron/electrolineras.env.example scripts/cron/electrolineras.env
#
# El crontab carga este fichero vía run_scheduled_job.sh

# Repo con .venv actualizado (git pull + pip install -e . tras despliegues)
ELECTROLINERAS_REPO=/mnt/datos/Proyectos/Electrolineras
ELECTROLINERAS_VENV=/mnt/datos/Proyectos/Electrolineras/.venv/bin

# Volumen Docker (misma BD que la API en :8015)
ELECTROLINERAS_DATA=/mnt/datos/docker/volumes/electrolineras-data
DATABASE_URL=sqlite:////mnt/datos/docker/volumes/electrolineras-data/db/stations.db

# Logs y locks
ELECTROLINERAS_LOG_DIR=/mnt/datos/docker/volumes/electrolineras-data/logs/cron
ELECTROLINERAS_LOCK_DIR=/tmp/electrolineras-cron-locks

# Umbrales verify_ingest.py (opcional)
MIN_TOTAL_STATIONS=18000
MIN_ES_STATIONS=10000
MIN_PT_STATIONS=7000
MIN_REVE_WITH_PRICE=5000

# Open Charge Map — obtener clave en https://openchargemap.io/site/develop/api
OCM_API_KEY=

# Alertas en fallo (#6052): webhook HTTP POST en fallo de ingest/verify.
# ntfy: https://ntfy.sh/TU-TOPICO-SECRETO — app móvil «Subscribe to topic».
# Slack/Discord: JSON {"text":...} / {"content":...} — ver notify_ingest_failure.sh
# INGEST_WEBHOOK_URL=https://ntfy.sh/electrolineras-ingest-ejemplo

# Backups (#6041)
# BACKUP_ROOT=/mnt/datos/docker/backups/electrolineras
# BACKUP_RAW_DIR=/mnt/datos/Proyectos/Electrolineras/data/raw
# BACKUP_PROCESSED_DIR=/mnt/datos/Proyectos/Electrolineras/data/processed
# BACKUP_DAILY_RETENTION_DAYS=7
# BACKUP_WEEKLY_RETENTION_DAYS=30
# BACKUP_PRE_PT_RETENTION_DAYS=7

# Monitoring (#6045)
# MONITOR_NOMINATIM_URL=http://127.0.0.1:8092/search?q=Madrid&format=json&limit=1&countrycodes=es
# MONITOR_API_URL=http://127.0.0.1:8015/health
# MONITOR_OSRM_CAR_URL=http://127.0.0.1:5000/route/v1/car/...?overview=false
# MONITOR_OSRM_SHORTEST_URL=http://127.0.0.1:5001/route/v1/shortest/...?overview=false
# MONITOR_DISK_WARN_PCT=85
# MONITOR_ALERT_COOLDOWN_MINUTES=180
