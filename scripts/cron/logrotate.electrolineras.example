# Logrotate — Electrolineras cron (#6040)
#
# Instalar en el mini PC:
#   sudo cp scripts/cron/logrotate.electrolineras.example \
#     /etc/logrotate.d/electrolineras
#
# Ajustar la ruta si ELECTROLINERAS_LOG_DIR difiere.

/mnt/datos/docker/volumes/electrolineras-data/logs/cron/*.log {
    su jualas jualas
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}

/mnt/datos/docker/volumes/electrolineras-data/logs/monitor/*.log {
    su jualas jualas
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
