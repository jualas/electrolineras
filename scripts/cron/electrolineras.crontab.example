# Crontab — Electrolineras (#6040)
#
# Instalar:
#   crontab -e
#   → pegar las líneas de job (sin comentarios de cabecera si prefieres).
#
# Probar manualmente:
#   bash /mnt/datos/Proyectos/Electrolineras/scripts/cron/run_scheduled_job.sh reve
#
# Logs: /mnt/datos/docker/volumes/electrolineras-data/logs/cron/

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# España — NAP DGT, diario 06:15
15 6 * * * /mnt/datos/Proyectos/Electrolineras/scripts/cron/run_scheduled_job.sh es

# Portugal — MOBI.E, cada 6 horas
0 */6 * * * /mnt/datos/Proyectos/Electrolineras/scripts/cron/run_scheduled_job.sh pt

# REVE — precio/disponibilidad, cada 3 horas (~25 min de duración)
0 */3 * * * /mnt/datos/Proyectos/Electrolineras/scripts/cron/run_scheduled_job.sh reve
