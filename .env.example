# Copiar a .env y ajustar valores locales
# cp .env.example .env

# SQLite (MVP) — ruta relativa al directorio raíz del repo
DATABASE_URL=sqlite:///data/db/stations.db

# API FastAPI
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# Frontend (Vite) — prefijo VITE_ expuesto al cliente
VITE_API_URL=http://127.0.0.1:8000

# Ingestión DATEX II (tareas #6023–6024)
NAP_ES_URL=https://infocar.dgt.es/datex2/v3/miterd/EnergyInfrastructureTablePublication/electrolineras.xml
NAP_PT_URL=https://pgm.mobie.pt/integration/nap/evChargingInfra
FETCH_MAX_RETRIES=3
FETCH_RETRY_BACKOFF_SECONDS=2
FETCH_TIMEOUT_SECONDS=120
FETCH_PT_TIMEOUT_SECONDS=900
