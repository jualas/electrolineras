# Copiar a .env y ajustar valores locales
# cp .env.example .env
#
# Producción: ver .env.production.example y docs/ENV.md
#   cp .env.production.example .env   # o docker/env.example en /mnt/datos/docker/electrolineras/

# SQLite (MVP) — ruta relativa al directorio raíz del repo
DATABASE_URL=sqlite:///data/db/stations.db

# API FastAPI
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
API_ENVIRONMENT=development
API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Hardening API (#6042) — activar en producción (ver .env.production.example)
# API_RATE_LIMIT_ENABLED=true
# API_TRUST_PROXY_HEADERS=true
# API_MAX_REQUEST_BODY_BYTES=65536
# API_DOCS_ENABLED=false
# API_DOCS_BASIC_AUTH_USER=
# API_DOCS_BASIC_AUTH_PASSWORD=

# Routing OSRM (#6029)
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=30
# Alternativas en «más rápida»: si tiempos OSRM difieren <5%, prefiere mayor velocidad media (p. ej. A-7/A-23)
OSRM_FASTEST_REQUEST_ALTERNATIVES=true
OSRM_FASTEST_ALTERNATIVES_COUNT=3
OSRM_FASTEST_ALTERNATIVE_TOLERANCE=0.05
# >1 acorta tiempos OSRM hacia Google/autovía (1.0 = bruto). Rango ~1.10–1.25
OSRM_SPEED_FACTOR=1.25
ROUTE_CORRIDOR_KM_DEFAULT=10
ROUTE_BEHIND_MARGIN_KM_DEFAULT=2
ROUTE_WRONG_SIDE_PENALTY_KM_DEFAULT=5
ROUTE_RESULTS_LIMIT_DEFAULT=10

# Geocodificación Nominatim (#6030)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_FALLBACK_BASE_URL=
NOMINATIM_USER_AGENT=Electrolineras/0.1.0 (dev; contact: local)
NOMINATIM_COUNTRY_CODES=es,pt
NOMINATIM_TIMEOUT_SECONDS=15
NOMINATIM_CACHE_ENABLED=true
NOMINATIM_CACHE_TTL_SECONDS=86400
NOMINATIM_CACHE_MAX_ENTRIES=2048
NEARBY_RADIUS_M_DEFAULT=1000
NEARBY_RADIUS_M_MAX=10000

# Servir build Vite desde FastAPI (opcional; nginx en prod)
SERVE_WEB_STATIC=false
WEB_DIST_PATH=src/web/dist

# Frontend (Vite) — prefijo VITE_ expuesto al cliente
VITE_API_URL=http://127.0.0.1:8000
# VITE_ROUTE_NAV_ENABLED=true
# VITE_TOMTOM_API_KEY=

# Ingestión DATEX II (tareas #6023–6024)
NAP_ES_URL=https://infocar.dgt.es/datex2/v3/miterd/EnergyInfrastructureTablePublication/electrolineras.xml
NAP_PT_URL=https://pgm.mobie.pt/integration/nap/evChargingInfra
FETCH_MAX_RETRIES=3
FETCH_RETRY_BACKOFF_SECONDS=2
FETCH_TIMEOUT_SECONDS=120
FETCH_PT_TIMEOUT_SECONDS=900

# Open Charge Map — valoraciones/comentarios (clave en https://openchargemap.io/site/develop/api)
OCM_API_KEY=

# REVE (mapareve.es) — API oficial con clave (https://www.mapareve.es/api-contacto)
# Si está definida, el sync usa /api/external/v1 en lugar de la API pública.
REVE_API_KEY=
# REVE_BASE_URL=

# Fase 3 — login TOTP multiusuario para la pestaña Asistente. Ver docs/PHASE3_AUTH.md
PRIVATE_STACK_ENABLED=false
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
AUTH_SESSION_MAX_AGE_SECONDS=604800
# "usuario1:SECRETO1,usuario2:SECRETO2" — generar con:
#   python scripts/auth/setup_private_auth.py --username <nombre> --apply .env
PRIVATE_AUTH_USERS=
PRIVATE_API_TOKEN=
AGENT_API_TOKEN=
CHARGING_AGENT_ENABLED=true

# Dify — guía de viaje IA (solo LAN minipc; ver docs/DIFY_TRIP_GUIDE.md)
DIFY_API_BASE_URL=http://<IP-LAN-SERVIDOR>:8590/v1
DIFY_TRIP_WORKFLOW_API_KEY=
DIFY_TIMEOUT_SECONDS=90
# Chat interactivo (#6166): puente Cursor (respuestas cortas; no monólogo)
CURSOR_BRIDGE_URL=http://<IP-LAN-SERVIDOR>:18765
# CURSOR_BRIDGE_TOKEN=
CURSOR_BRIDGE_TIMEOUT_SECONDS=90

# TeslaMate — ver /mnt/datos/docker/teslamate/INTEGRACION_APPS.md
TESLAMATE_DATA_SOURCE=auto
TESLAMATE_CAR_ID=1
TESLAMATE_CAR_DISPLAY_NAME=The Ship
TESLAMATE_MQTT_HOST=<IP-LAN-SERVIDOR>
TESLAMATE_MQTT_PORT=1883
TESLAMATE_MQTT_USERNAME=jualas
TESLAMATE_MQTT_PASSWORD=
TESLAMATE_MQTT_TOPIC_PREFIX=teslamate/cars
# Consumo real TeslaMate (cars.efficiency, kWh/km). The Ship ≈ 0.13733 → 137 Wh/km.
TESLAMATE_EFFICIENCY_KWH_PER_KM=0.13733
# Capacidad útil (kWh) medida vía cargas ≈ 57.5 (SR+).
TESLAMATE_USABLE_CAPACITY_KWH=57.5
# Opcional si despliegas TeslaMateApi:
TESLAMATE_API_BASE_URL=
TESLAMATE_API_TOKEN=
